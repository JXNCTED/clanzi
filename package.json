{
  "name": "clanzi",
  "version": "0.1.1",
  "description": "Linux desktop key mapper for Ulanzi Vibe Key (AU05)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "npx --yes @tauri-apps/cli@2",
    "test": "node --test tests/frontend.test.mjs",
    "test:core": "cargo test --offline",
    "check": "npm run build && npm test && cargo test --offline"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "lucide-react": "0.577.0"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "playwright": "1.59.1"
  },
  "license": "MIT"
}
