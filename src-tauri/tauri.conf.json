{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "clanzi",
  "version": "0.1.0",
  "identifier": "io.clanzi.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "clanzi", "width": 1120, "height": 860, "minWidth": 520, "minHeight": 420, "backgroundColor": "#101112" }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost; script-src 'self'" }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "category": "Utility",
    "shortDescription": "Linux key mapper for Ulanzi Vibe Key (AU05)",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png"],
    "linux": { "appimage": {
      "files": {
        "/usr/share/doc/clanzi/LICENSE": "../LICENSE",
        "/usr/share/doc/clanzi/THIRD_PARTY_NOTICES.md": "../THIRD_PARTY_NOTICES.md"
      }
    }, "deb": {
      "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0", "libayatana-appindicator3-1", "dbus-bin", "udev", "kmod"],
      "postInstallScript": "../packaging/postinst",
      "postRemoveScript": "../packaging/postrm",
      "files": {
        "/usr/share/doc/clanzi/LICENSE": "../LICENSE",
        "/usr/share/doc/clanzi/THIRD_PARTY_NOTICES.md": "../THIRD_PARTY_NOTICES.md",
        "/usr/lib/udev/rules.d/70-clanzi.rules": "../packaging/70-clanzi.rules",
        "/usr/lib/modules-load.d/clanzi.conf": "../packaging/clanzi.conf"
      }
    }}
  }
}
